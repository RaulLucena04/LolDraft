{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LolDraft",
  "version": "0.1.9",
  "identifier": "com.loldraft.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace loldraft-desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace loldraft-desktop",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LolDraft — Draft Assistant",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
